# AURA Platform Environment Configuration Example

# Environment
APP_ENV=development
APP_NAME="AURA - Autonomous Enterprise Intelligence Platform"
DEBUG=true
LOG_LEVEL=INFO

# Server
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Security & Auth
SECRET_KEY=aura-super-secret-production-grade-encryption-key-change-in-production-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
# For production PostgreSQL with pgvector:
# DATABASE_URL=postgresql+asyncpg://aura_user:aura_password@localhost:5432/aura_db
# For local / development zero-dependency execution:
DATABASE_URL=sqlite+aiosqlite:///./aura.db

# Redis & Cache
REDIS_URL=redis://localhost:6379/0

# Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# AI Provider Settings
# Supported providers: openai, gemini, anthropic, mock_local
AI_PROVIDER=mock_local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# RAG & Embeddings
EMBEDDING_DIMENSION=384
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K_RETRIEVAL=5
HYBRID_ALPHA=0.5
SIMILARITY_THRESHOLD=0.65

# MCP Server
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8001
MCP_ENABLED=true

# Evaluation & Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
EVAL_SAMPLE_SIZE=20
